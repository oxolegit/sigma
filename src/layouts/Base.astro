---
import '../styles/global.css';
import ProgressImport from '../components/live/ProgressImport';
import { SITE } from '../lib/site';
interface Props {
  title: string;
  description?: string;
  /** website — главная, article — урок, контрольная, шпаргалка. */
  type?: 'website' | 'article';
  /** Служебные страницы не индексируются. */
  noindex?: boolean;
}
const { title, description = SITE.description, type = 'article', noindex = false } = Astro.props;
// Абсолютные адреса для превью ссылок: site задан в astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(SITE.image.src, Astro.site);
---
<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE.image.width)} />
    <meta property="og:image:height" content={String(SITE.image.height)} />
    <meta property="og:image:alt" content={SITE.image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={SITE.image.alt} />
    <slot name="head" />
    <script is:inline>
      (function () {
        var root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)');
        var saved = function () { try { return localStorage.getItem('sigma:theme'); } catch (e) { return null; } };
        var apply = function () { root.dataset.theme = saved() || (mq.matches ? 'dark' : 'light'); };
        apply();
        // Пока тема не выбрана явно, сайт следует за системой и на лету.
        mq.addEventListener('change', function () { if (!saved()) apply(); });
        // Печать — всегда в светлой теме, после печати тема возвращается.
        var before = null;
        addEventListener('beforeprint', function () { before = root.dataset.theme; root.dataset.theme = 'light'; });
        addEventListener('afterprint', function () { if (before) root.dataset.theme = before; before = null; });
      })();
    </script>
  </head>
  <body>
    <slot />
    <ProgressImport client:idle />
  </body>
</html>
