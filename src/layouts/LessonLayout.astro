---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { AskBlock } from '../components';
import LiveLessonNav from '../components/live/LiveLessonNav';
import LiveCourseProgress from '../components/live/LiveCourseProgress';
import LiveLessonFooter from '../components/live/LiveLessonFooter';
import RememberVisit from '../components/live/RememberVisit';
import PageToc from '../components/live/PageToc';
import Literature from '../components/Literature.astro';
import { courseHref, lessonStats, type CourseData, type OutlineLesson } from '../lib/courses';
import { plural } from '../lib/plural';

interface Props { data: CourseData; lesson: OutlineLesson }
const { data, lesson } = Astro.props;
const entry = lesson.entry!;
const { title: courseTitle } = data.course.data;
const all = data.lessons.map((l) => l.n);
const index = data.lessons.findIndex((l) => l.n === lesson.n);
const nextLesson = data.lessons.slice(index + 1).find((l) => l.href);
const next = nextLesson ? { n: nextLesson.n, title: nextLesson.title, href: nextLesson.href } : undefined;
const prevLesson = data.lessons.slice(0, index).reverse().find((l) => l.href);
const prev = prevLesson ? { n: prevLesson.n, title: prevLesson.title, href: prevLesson.href! } : undefined;
const chapters = data.chapters.map((ch) => ({ ...ch, lessons: ch.lessons.map((l) => ({ ...l, current: l.n === lesson.n })) }));
const eyebrow = [`Урок ${lesson.n}`, lesson.ref, lesson.chapterNo].filter(Boolean).join(' · ');
const { labs, trainers, questions } = lessonStats(entry);
const meta = [
  entry.data.minutes && `≈ ${entry.data.minutes} ${plural(entry.data.minutes, 'минута', 'минуты', 'минут')}`,
  labs && `${labs} ${plural(labs, 'лаборатория', 'лаборатории', 'лабораторий')}`,
  trainers && `${trainers} ${plural(trainers, 'тренажёр', 'тренажёра', 'тренажёров')}`,
  questions && `${questions} ${plural(questions, 'вопрос', 'вопроса', 'вопросов')} в конце`,
].filter(Boolean).join(' · ');
---
<Base title={`Урок ${lesson.n}. ${lesson.title} — ${courseTitle} — Sigma`} description={entry.data.lead}>
  <div class="sg-page sg-page-wide">
    <SiteHeader course={{ title: courseTitle, href: courseHref(data.id) }}>
      <LiveCourseProgress client:idle course={data.id} lessons={all} label="Курс" compact />
    </SiteHeader>
    <RememberVisit client:idle course={data.id} n={lesson.n} title={lesson.title} courseTitle={courseTitle} href={lesson.href!} />

    <div class="sg-strip">
      <LiveLessonNav client:idle course={data.id} chapters={chapters} layout="strip" />
    </div>

    <div class="sg-lesson-grid">
      <aside class="sg-side">
        <LiveLessonNav client:idle course={data.id} chapters={chapters} />
      </aside>

      <article class="sg-article">
        <div class="sg-lesson-head">
          <div class="sg-eyebrow sg-eyebrow-accent">{eyebrow}</div>
          <h1>{lesson.title}</h1>
          {meta && <div class="sg-lesson-meta">{meta}</div>}
        </div>

        {entry.data.lead && <p class="sg-lead">{entry.data.lead}</p>}
        {entry.data.ask.length > 0 && <AskBlock items={entry.data.ask} />}

        <div class="sg-lesson-body">
          <slot />
        </div>

        <Literature refs={lesson.refs} />

        <LiveLessonFooter client:idle course={data.id} n={lesson.n} next={next} />
      </article>

      <aside class="sg-toc-col">
        <PageToc client:idle prev={prev} next={next ? { ...next, href: next.href! } : undefined} />
      </aside>
    </div>
  </div>
</Base>

<style is:global>
  .sg-page-wide { max-width: 1480px; }
  .sg-strip { display: none; }

  /* Три колонки: уроки курса | текст | «на этой странице». Правая — только на широком экране. */
  .sg-lesson-grid { display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr); gap: var(--space-8) 48px; padding-top: 40px; }
  .sg-side, .sg-toc-col .sg-toc { position: sticky; top: calc(var(--header-h) + var(--space-6)); align-self: start; max-height: calc(100vh - var(--header-h) - 2 * var(--space-6)); overflow-y: auto; scrollbar-width: thin; }
  .sg-toc-col { display: contents; }
  .sg-toc { display: none; }
  @media (min-width: 1360px) {
    .sg-lesson-grid { grid-template-columns: 248px minmax(0, 1fr) 220px; }
    .sg-toc-col { display: block; }
    .sg-toc { display: block; }
  }
  .sg-article { min-width: 0; max-width: 900px; display: flex; flex-direction: column; gap: var(--space-8); }

  .sg-toc-title { padding: 0 var(--space-3) var(--space-2); font: 750 11px/14px var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); }
  .sg-toc-list { margin: 0; padding: 0; list-style: none; border-left: 2px solid var(--rule); }
  .sg-toc-list a { display: block; margin-left: -2px; padding: 6px var(--space-3); border-left: 2px solid transparent; font: 550 13px/18px var(--font-sans); color: var(--ink-muted); }
  .sg-toc-list a:hover { color: var(--ink); }
  .sg-toc-list a[aria-current] { border-left-color: var(--accent); color: var(--accent-text); font-weight: 700; }
  .sg-toc-list .is-lab a { padding-left: calc(var(--space-3) + 12px); font-size: 12px; }
  .sg-toc-list .is-lab a::before { content: "∿ "; color: var(--accent-text); }

  /* Панель урока на телефоне: прогресс чтения, соседние уроки, содержание */
  .sg-lbar { display: none; }
  @media (max-width: 899px) {
    .sg-lbar { position: fixed; left: var(--space-3); right: var(--space-3); bottom: max(var(--space-3), env(safe-area-inset-bottom)); z-index: 30; display: block; overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius-xl); background: var(--glass); -webkit-backdrop-filter: saturate(1.6) blur(14px); backdrop-filter: saturate(1.6) blur(14px); box-shadow: var(--shadow-pop); }
    .sg-lbar-read { height: 3px; background: var(--accent); transform-origin: left; }
    .sg-lbar-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-1); padding: 4px; }
    .sg-lbar-btn { display: grid; place-items: center; min-width: 48px; height: 44px; padding: 0 12px; border-radius: var(--radius-pill); font: 750 14px/20px var(--font-sans); color: var(--ink); }
    .sg-lbar-btn.is-off { color: var(--rule-strong); }
    .sg-lbar-toc { min-width: 0; height: 44px; padding: 0 12px; border: 0; border-radius: var(--radius-pill); background: var(--surface-2); color: var(--ink); font: 650 13px/20px var(--font-sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
    .sg-lbar-sheet { max-height: 55vh; overflow-y: auto; padding: var(--space-3) var(--space-2) var(--space-1); border-bottom: 1px solid var(--rule); }
    .sg-page-wide { padding-bottom: 96px; }
  }

  .sg-lesson-head { display: flex; flex-direction: column; gap: var(--space-3); }
  .sg-lesson-head h1 { margin: 0; font: 800 clamp(28px, 3.4vw, 44px)/1.1 var(--font-sans); letter-spacing: -0.03em; }
  .sg-lesson-meta { display: flex; flex-wrap: wrap; gap: 6px; font: 600 13px/20px var(--font-sans); color: var(--ink-muted); }
  .sg-lead { margin: 0; max-width: var(--measure); font: 400 20px/32px var(--font-serif); color: var(--ink-muted); }

  /* Тело урока: текст — колонкой ~70 знаков серифом, лаборатории и выводы — во всю ширину колонки */
  .sg-lesson-body { display: flex; flex-direction: column; }
  .sg-lesson-body > :is(p, ul, ol, blockquote, h2, h3) { max-width: var(--measure); }
  .sg-lesson-body > :is(p, ul, ol) { margin: 0 0 18px; font: 400 18px/30px var(--font-serif); }
  .sg-lesson-body > :is(ul, ol) { padding-left: 1.4em; }
  .sg-lesson-body li + li { margin-top: 6px; }
  .sg-lesson-body > h2 { margin: var(--space-12) 0 14px; font: 800 28px/34px var(--font-sans); letter-spacing: -0.02em; }
  .sg-lesson-body > h2:first-child { margin-top: 0; }
  .sg-lesson-body > h3 { margin: var(--space-6) 0 10px; font: 750 20px/26px var(--font-sans); letter-spacing: -0.01em; }
  .sg-lesson-body .katex-display { margin: 0.4em 0; }
  .sg-lesson-body > blockquote { margin: 0 0 18px; padding: var(--space-3) var(--space-4); border-left: 3px solid var(--accent); border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--accent-soft); }
  .sg-lesson-body > blockquote p { margin: 0 0 10px; font: 400 17px/28px var(--font-serif); }
  .sg-lesson-body > blockquote p:last-child { margin-bottom: 0; }
  .sg-lesson-body strong { font-weight: 600; }
  .sg-lesson-body :is(.rz-lab, .rz-steps) { margin: var(--space-4) 0 var(--space-8); }
  .sg-lesson-body .sg-check .rz-quiz { margin: 0; }

  @media (max-width: 899px) {
    .sg-strip { display: block; margin: 0 calc(-1 * var(--space-4)); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--rule); overflow: hidden; }
    .sg-lesson-grid { display: block; padding-top: var(--space-6); }
    .sg-side { display: none; }
    .sg-article { gap: 28px; }
    .sg-lead { font-size: 18px; line-height: 28px; }
    .sg-lesson-body > :is(p, ul, ol) { font-size: 17px; line-height: 28px; }
    .sg-lesson-body > h2 { margin-top: var(--space-8); font-size: 24px; line-height: 30px; }
  }
</style>
