---
import { getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import { getCourse, lessonSlug } from '../../lib/courses';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  const paths = [];
  for (const c of courses) {
    const data = await getCourse(c.id);
    for (const lesson of data.lessons) {
      if (lesson.entry) paths.push({ params: { course: c.id, lesson: lessonSlug(lesson.entry) }, props: { data, lesson } });
    }
  }
  return paths;
}

const { data, lesson } = Astro.props;
const { Content } = await render(lesson.entry!);
---
<LessonLayout data={data} lesson={lesson}>
  <Content />
</LessonLayout>
