---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/exam.css';
import SiteHeader from '../../components/SiteHeader.astro';
import { Button } from '../../components';
import ExamScore from '../../components/live/ExamScore';
import { courseHref, getCourse, lessonStats, sheetHref, type CourseData } from '../../lib/courses';

export async function getStaticPaths() {
  // Самостоятельные (id вида курс/srN) — на своей странице, здесь только контрольные.
  const exams = (await getCollection('exams')).filter((e) => !e.id.includes('/'));
  return Promise.all(exams.map(async (e) => ({ params: { course: e.id }, props: { data: await getCourse(e.id) } })));
}

const { data } = Astro.props as { data: CourseData };
const exam = data.exam!;
const { Content } = await render(exam);
const total = lessonStats(exam).questions;
const courseTitle = data.course.data.title;
---
<Base title={`Пробная контрольная — ${courseTitle} — Sigma`} description={exam.data.lead}>
  <div class="sg-page">
    <SiteHeader course={{ title: courseTitle, href: courseHref(data.id) }} />

    <article class="sg-exam">
      <div class="sg-exam-head">
        <div class="sg-eyebrow sg-eyebrow-accent">Пробная контрольная{exam.data.scope ? ` · ${exam.data.scope}` : ''}</div>
        <h1>{exam.data.title}</h1>
        {exam.data.lead && <p class="sg-lead">{exam.data.lead}</p>}
      </div>

      <div class="sg-exam-sticky">
        <ExamScore client:load total={total} />
      </div>

      <div class="sg-exam-body">
        <Content />
      </div>

      <div class="sg-row">
        <Button variant="primary" href={sheetHref(data.id)}>Открыть шпаргалку</Button>
        <Button href={courseHref(data.id)}>К урокам курса</Button>
      </div>
    </article>
  </div>
</Base>
