---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { Button } from '../../components';
import ExamScore from '../../components/live/ExamScore';
import { courseHref, getCourse, lessonStats, sheetHref, type CourseData } from '../../lib/courses';

export async function getStaticPaths() {
  const exams = await getCollection('exams');
  return Promise.all(exams.map(async (e) => ({ params: { course: e.id }, props: { data: await getCourse(e.id) } })));
}

const { data } = Astro.props as { data: CourseData };
const exam = data.exam!;
const { Content } = await render(exam);
const total = lessonStats(exam).questions;
const courseTitle = data.course.data.title;
---
<Base title={`Пробная контрольная — ${courseTitle} — Sigma`} description={exam.data.lead}>
  <div class="sg-page">
    <SiteHeader course={{ title: courseTitle, href: courseHref(data.id) }} />

    <article class="sg-exam">
      <div class="sg-exam-head">
        <div class="sg-eyebrow sg-eyebrow-accent">Пробная контрольная{exam.data.scope ? ` · ${exam.data.scope}` : ''}</div>
        <h1>{exam.data.title}</h1>
        {exam.data.lead && <p class="sg-lead">{exam.data.lead}</p>}
      </div>

      <div class="sg-exam-sticky">
        <ExamScore client:load total={total} />
      </div>

      <div class="sg-exam-body">
        <Content />
      </div>

      <div class="sg-row">
        <Button variant="primary" href={sheetHref(data.id)}>Открыть шпаргалку</Button>
        <Button href={courseHref(data.id)}>К урокам курса</Button>
      </div>
    </article>
  </div>
</Base>

<style is:global>
  .sg-exam { max-width: 760px; margin: 0 auto; padding-top: 40px; display: flex; flex-direction: column; gap: var(--space-8); }
  .sg-exam-head { display: flex; flex-direction: column; gap: var(--space-3); }
  .sg-exam-head h1 { margin: 0; font: 600 34px/40px var(--font-sans); letter-spacing: -0.015em; }
  .sg-lead { margin: 0; max-width: var(--measure); font: 400 18px/30px var(--font-serif); color: var(--ink-muted); }

  /* Счёт прилипает к верху, пока решаешь */
  .sg-exam-sticky { position: sticky; top: 0; z-index: 2; margin: 0 calc(-1 * var(--space-2)); padding: var(--space-2); background: var(--paper); }
  .sg-exam-score { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); padding: 16px 20px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-lg); }
  .sg-exam-score-main { flex: 1 1 260px; }
  .sg-exam-score-bar { flex: 0 1 220px; }

  .sg-exam-body { display: flex; flex-direction: column; gap: var(--space-6); }
  .sg-exam-body > h2 { margin: var(--space-6) 0 0; font: 600 22px/28px var(--font-sans); }
  .sg-exam-body > h2:first-child { margin-top: 0; }
  .sg-exam-body > h3 { margin: var(--space-6) 0 0; padding-top: var(--space-6); border-top: 1px solid var(--rule); font: 600 17px/24px var(--font-sans); color: var(--ink-muted); }
  .sg-exam-body .rz-quiz { padding-bottom: 28px; border-bottom: 1px solid var(--rule); }

  @media (max-width: 899px) {
    .sg-exam { padding-top: var(--space-6); gap: var(--space-6); }
    .sg-exam-head h1 { font-size: 26px; line-height: 32px; }
    .sg-lead { font-size: 17px; line-height: 28px; }
    .sg-exam-score { padding: 12px 16px; }
  }
  @media print { .sg-exam-sticky { position: static; } }
</style>
