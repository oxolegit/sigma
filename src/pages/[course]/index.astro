---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import CourseActions from '../../components/live/CourseActions';
import CourseOutline from '../../components/live/CourseOutline';
import LiveCourseProgress from '../../components/live/LiveCourseProgress';
import Literature from '../../components/Literature.astro';
import { examHref, getCourse, lessonStats, sheetHref, type CourseData } from '../../lib/courses';
import { plural } from '../../lib/plural';
import { FIXED_VARIANTS } from '../../lib/variants';

export async function getStaticPaths() {
  const courses = (await getCollection('courses')).filter((c) => !c.data.example);
  return Promise.all(courses.map(async (c) => ({ params: { course: c.id }, props: { data: await getCourse(c.id) } })));
}

const { data } = Astro.props as { data: CourseData };
const c = data.course.data;
const examQuestions = data.exam ? lessonStats(data.exam).questions : 0;
const labWord = (n: number) => plural(n, 'лаборатория', 'лаборатории', 'лабораторий');

const chapters = data.chapters.map((ch) => ({
  label: ch.label,
  name: ch.name,
  lessons: data.lessons.filter((l) => l.chapter === ch.title).map((l) => {
    const labs = l.entry ? lessonStats(l.entry).labs : 0;
    // У ненаписанного урока «готовится» уже стоит в статусе справа — в подписи только параграф.
    const meta = [l.ref, l.entry && (labs ? `${labs} ${labWord(labs)}` : 'без лабораторий')].filter(Boolean).join(' · ');
    return { n: l.n, title: l.title, meta, href: l.href, labs };
  }),
}));
const written = data.lessons.filter((l) => l.href).map((l) => ({ n: l.n, href: l.href! }));
// Самостоятельные: что покрывают и сколько в них задач.
const works = data.works.map((w) => {
  const st = lessonStats(w.entry);
  // Вариант — задачи с генерацией чисел, четыре фиксированных варианта и случайные; иначе — все задачи страницы.
  const tasks = st.variant ? `вариант из ${st.tasks} ${plural(st.tasks, 'задачи', 'задач', 'задач')}, ${FIXED_VARIANTS} варианта и случайные` : `${st.tasks + st.solved} ${plural(st.tasks + st.solved, 'задача', 'задачи', 'задач')}`;
  const from = w.entry.data.lessons;
  return {
    n: w.n, href: w.href, title: w.entry.data.title, scope: w.entry.data.scope,
    meta: [from.length ? `уроки ${Math.min(...from)}–${Math.max(...from)}` : '', tasks].filter(Boolean).join(' · '),
  };
});
const stats = [
  [data.lessons.length, plural(data.lessons.length, 'урок', 'урока', 'уроков')],
  [data.labs, labWord(data.labs)],
  ...(examQuestions ? [[examQuestions, 'в контрольной']] : []),
  ...(data.works.length ? [[data.works.length, plural(data.works.length, 'самостоятельная', 'самостоятельные', 'самостоятельных')]] : []),
] as [number, string][];
---
<Base title={`${c.title} — Sigma`} description={c.description}>
  <div class="sg-page">
    <SiteHeader current="courses" />
    <nav class="sg-crumbs" aria-label="Путь"><a href="/">Курсы</a> / {c.title}</nav>

    <section class="sg-course-hero">
      <div class="sg-course-text">
        <div class="sg-eyebrow">{[c.subject, c.semester].filter(Boolean).join(' · ')}</div>
        <h1>{c.title}</h1>
        {c.source && <p class="sg-course-source">{c.source}</p>}
        {c.description && <p class="sg-course-desc">{c.description}</p>}
        <CourseActions client:idle course={data.id} written={written} examHref={data.exam ? examHref(data.id) : undefined} works={works.map((w) => ({ n: w.n, href: w.href }))} sheetHref={sheetHref(data.id)} />
      </div>
      <div class="sg-course-card">
        <LiveCourseProgress client:idle course={data.id} lessons={data.lessons.map((l) => l.n)} label="Мой прогресс" />
        <dl class="sg-course-stats">
          {stats.map(([n, word]) => <div><dt>{word}</dt><dd>{n}</dd></div>)}
        </dl>
      </div>
    </section>

    <CourseOutline client:idle course={data.id} chapters={chapters} />

    {works.length > 0 && (
      <section class="sg-works" aria-labelledby="works-h">
        <div class="sg-outline-head">
          <div class="sg-eyebrow">Проверка</div>
          <h2 id="works-h">Самостоятельные работы</h2>
        </div>
        <ul class="sg-outline-list">
          {works.map((w) => (
            <li>
              <a class="sg-outline-row" href={w.href}>
                <span class="sg-outline-mark" aria-hidden="true">С{w.n}</span>
                <span class="sg-outline-text">
                  <span class="sg-outline-title">{w.title}</span>
                  <span class="sg-outline-meta">{[w.scope, w.meta].filter(Boolean).join(' · ')}</span>
                </span>
                <span class="sg-outline-status">решать →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="sg-course-lit"><Literature sources={c.literature} /></div>
  </div>
</Base>

<style is:global>
  .sg-course-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 340px; align-items: end; gap: var(--space-8) var(--space-12); padding: 24px 0 40px; }
  .sg-course-hero::before { content: ""; position: absolute; inset: -60px 0 0; z-index: -1; background: var(--hero-glow); pointer-events: none; }
  .sg-course-text { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sg-course-text h1 { margin: 0; font: 800 clamp(34px, 4.6vw, 56px)/1.04 var(--font-sans); letter-spacing: -0.035em; }
  .sg-course-source { margin: 0; font: 600 15px/22px var(--font-sans); color: var(--ink-muted); }
  .sg-course-desc { margin: 0; max-width: var(--measure); font: 400 17px/28px var(--font-serif); color: var(--ink-muted); }
  .sg-course-actions { display: flex; flex-direction: column; gap: var(--space-3); padding-top: var(--space-2); }
  .sg-share-status { font: 500 14px/20px var(--font-sans); color: var(--ink-muted); overflow-wrap: anywhere; }
  .sg-course-card { display: flex; flex-direction: column; gap: 20px; padding: 24px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-xl); box-shadow: var(--shadow-lift); }
  .sg-course-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); margin: 0; }
  .sg-course-stats div { display: flex; flex-direction: column-reverse; padding: 10px 12px; border-radius: var(--radius-md); background: var(--surface-2); }
  .sg-course-stats dt { font: 600 12px/16px var(--font-sans); color: var(--ink-muted); }
  .sg-course-stats dd { margin: 0; font: 800 26px/30px var(--font-sans); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }

  .sg-course-lit { margin-top: var(--space-12); }
  .sg-outline { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-4); }
  .sg-outline > .sg-chips { margin-bottom: var(--space-2); }
  .sg-works { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: var(--space-3) var(--space-8); margin-top: var(--space-4); padding: var(--space-6); border: 1px solid color-mix(in srgb, var(--signal) 30%, var(--rule)); border-radius: var(--radius-xl); background: var(--signal-soft); }
  .sg-outline-chapter { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: var(--space-3) var(--space-8); padding: var(--space-6); background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-xl); }
  .sg-outline-head { display: flex; flex-direction: column; gap: 6px; }
  .sg-outline-head h2 { margin: 0; font: 800 22px/28px var(--font-sans); letter-spacing: -0.02em; }
  .sg-outline-list { margin: 0; padding: 0; list-style: none; }
  .sg-outline-list li + li { margin-top: 4px; }
  .sg-outline-row { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; min-height: 52px; padding: 10px 12px; border-radius: var(--radius-md); color: var(--ink); transition: background .15s; }
  a.sg-outline-row:hover { background: var(--surface-2); color: var(--ink); }
  .sg-works a.sg-outline-row { background: var(--surface-1); }
  .sg-works a.sg-outline-row:hover { background: var(--surface-1); box-shadow: var(--shadow-lift); }
  .sg-outline-row.is-current { background: var(--accent-soft); }
  .sg-outline-row.is-current .sg-outline-title { color: var(--accent-text); }
  .sg-outline-row.is-soon .sg-outline-title { color: var(--ink-muted); }
  .sg-outline-mark { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-pill); background: var(--surface-2); color: var(--ink-muted); font: 750 13px/1 var(--font-sans); font-variant-numeric: tabular-nums; }
  .sg-works .sg-outline-mark { background: var(--signal); color: #ffffff; }
  .sg-outline-mark.is-done { background: var(--correct-soft); color: var(--correct); }
  .sg-outline-mark.is-current { background: var(--accent); color: var(--on-accent); }
  .sg-outline-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .sg-outline-title { font: 650 16px/22px var(--font-sans); }
  .sg-outline-meta { font: 500 13px/18px var(--font-sans); color: var(--ink-muted); }
  .sg-outline-status { font: 700 13px/18px var(--font-sans); color: var(--accent-text); white-space: nowrap; }
  .sg-outline-status.is-done { color: var(--correct); }
  .sg-outline-row.is-soon .sg-outline-status { color: var(--ink-muted); font-weight: 500; }

  @media (max-width: 899px) {
    .sg-course-hero { grid-template-columns: 1fr; padding-bottom: 28px; }
    .sg-outline-chapter, .sg-works { grid-template-columns: 1fr; padding: var(--space-4); }
    .sg-outline-row { grid-template-columns: 32px minmax(0, 1fr); padding: 10px 8px; }
    .sg-outline-status { grid-column: 2; }
    .sg-outline-status:empty { display: none; }
  }
</style>
