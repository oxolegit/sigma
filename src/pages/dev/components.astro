---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { AskBlock, Badge, CourseCard, FormulaCard, Progress, TeX } from '../../components';
import Showcase from './_Showcase';
---
<Base title="Компоненты — Sigma" noindex>
  <main class="sg-dev">
    <header class="sg-dev-header"><Logo /><span>Витрина компонентов</span></header>

    <section>
      <h2>TeX</h2>
      <p class="rz-prose">Строчная <TeX tex={String.raw`\Sigma_t = N\sigma`} /> и выносная:</p>
      <TeX tex={String.raw`I(x) = I_0\, e^{-\Sigma_t x}`} block />
      <p class="rz-prose">Битый TeX показывается исходником: <TeX tex={String.raw`\frac{1}{`} /></p>
    </section>

    <section>
      <h2>Badge</h2>
      <div class="sg-dev-row">
        <Badge>ядерная физика</Badge><Badge tone="accent">новый</Badge>
        <Badge tone="signal">скоро контрольная</Badge><Badge tone="example">пример</Badge>
      </div>
    </section>

    <section>
      <h2>Progress</h2>
      <Progress value={4} total={10} label="Мой прогресс" />
      <div style="max-width: 220px"><Progress value={3} total={10} label="Курс" compact /></div>
    </section>

    <section>
      <h2>CourseCard</h2>
      <div class="sg-dev-grid">
        <CourseCard title="Теория переноса нейтронов" source="Крючков, Юрова · МИФИ, 2007" subject="Ядерная физика" semester="1 семестр" lessons={10} labs={18} done={4} href="#" />
        <CourseCard title="Физика ядерных реакторов" source="Учебник для примера" subject="Ядерная физика" semester="2 семестр" lessons={12} labs={9} example href="#" />
        <CourseCard title="Методы Монте-Карло в физике переноса" subject="Вычислительная физика" lessons={1} labs={2} done={1} example />
      </div>
    </section>

    <section>
      <h2>AskBlock</h2>
      <AskBlock items={[
        'Вывести закон ослабления узкого пучка $I(x) = I_0 e^{-\\Sigma_t x}$',
        'Объяснить смысл $e^{-\\Sigma_t x}$ как вероятности пройти слой без взаимодействия',
        'Вывести, что $\\lambda = 1/\\Sigma_t$',
      ]} />
    </section>

    <section>
      <h2>FormulaCard</h2>
      <div class="rz-sheet">
        <FormulaCard n="4.1" title="Закон ослабления" ref="§1.6" tex={String.raw`I(x) = I_0\, e^{-\Sigma_t x}`} note="Узкий пучок, однородная среда." />
        <FormulaCard n="4.2" title="Длина свободного пробега" ref="§1.6" tex={String.raw`\lambda = 1/\Sigma_t`} />
        <FormulaCard n="3.1" title="Макросечение" ref="§1.5" tex={String.raw`\Sigma = N\sigma`} note="$N$ — ядерная плотность, см⁻³." />
        <FormulaCard n="7.1" title="Закон Фика" ref="§2.2" tex={String.raw`\mathbf{J} = -D\, \nabla \Phi, \quad D = \frac{1}{3\Sigma_{tr}}`} />
      </div>
    </section>

    <Showcase client:load />
  </main>
</Base>

<style is:global>
  .sg-dev { max-width: 820px; margin: 0 auto; padding: 0 var(--space-4) var(--space-16); display: flex; flex-direction: column; gap: var(--space-12); }
  .sg-dev-header { display: flex; align-items: center; gap: var(--space-4); padding: 18px 0; border-bottom: 1px solid var(--rule); color: var(--ink-muted); }
  .sg-dev h2 { margin: 0 0 var(--space-4); font: 600 13px/16px var(--font-sans); letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-muted); }
  .sg-dev section { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .sg-dev section > * { max-width: 100%; }
  .sg-dev section > :is(.rz-lab, .rz-steps, .rz-quiz, .rz-progress, .rz-ask, .rz-sheet, .rz-lfoot, .rz-score, .sg-dev-grid, .rz-tex-block, div) { align-self: stretch; }
  .sg-dev-row { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .sg-dev-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); }
  .sg-dev-stack { display: flex; flex-direction: column; gap: var(--space-12); }
  .sg-dev-stage { display: grid; place-items: center; width: 100%; height: 100%; color: var(--ink-muted); }
</style>
