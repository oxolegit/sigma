---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CourseCatalog from '../components/live/CourseCatalog';
import ContinueCard from '../components/live/ContinueCard';
import SlabMC3D from '../labs/tpn/SlabMC3D';
import BigFormula from '../components/live/BigFormula';
import DotField from '../components/live/DotField';
import { getEntry } from 'astro:content';
import { getCourse, listCourses, siteStats } from '../lib/courses';
import { plural } from '../lib/plural';
import { SITE } from '../lib/site';

const courses = await listCourses();
const lessonsByCourse = Object.fromEntries(courses.filter((c) => !c.example).map((c) => [c.id, c.lessons]));
const stats = await siteStats();

// Пока ничего не открыто, «Начать» ведёт к первому уроку курса, где написано больше всего уроков.
const real = await Promise.all(courses.filter((c) => !c.example).map((c) => getCourse(c.id)));
const fullest = real.sort((a, b) => b.lessons.filter((l) => l.href).length - a.lessons.filter((l) => l.href).length)[0];
const firstLesson = fullest?.lessons.find((l) => l.href);
const fallback = fullest && firstLesson
  ? { course: fullest.id, n: firstLesson.n, title: firstLesson.title, courseTitle: fullest.course.data.title, href: firstLesson.href! }
  : undefined;
// Урок, из которого взята лаборатория на главной.
const demoLesson = real.flatMap((d) => d.lessons).find((l) => l.entry?.body?.includes('@labs/tpn/SlabMC3D'));

const numbers = [
  { value: stats.lessons, label: plural(stats.lessons, 'урок', 'урока', 'уроков'), note: 'по учебнику и лекциям' },
  { value: stats.labs, label: plural(stats.labs, 'лаборатория', 'лаборатории', 'лабораторий'), note: `из них ${stats.labs3d} в 3D` },
  { value: stats.questions + stats.tasks, label: 'заданий для самопроверки', note: `${stats.questions} вопросов и ${stats.tasks} задач в контрольной и самостоятельных` },
  { value: stats.formulas, label: plural(stats.formulas, 'формула', 'формулы', 'формул'), note: 'в шпаргалке на А4' },
];

// Формула на главной — запись из реестра формул: та же, что откроется в попапе.
const hero = (await getEntry('formulas', 'nuclear'))?.data.items.find((f) => f.id === 'energy-momentum');

const features: { mark: string; title: string; text: string; wide?: boolean; tone?: 'accent' | 'signal' }[] = [
  { mark: 'ƒ', title: 'Формулы, которые объясняют себя', text: 'Нажмите на выносную формулу — откроется разбор: что значит каждый символ, когда применять, откуда берётся и где ещё встречается.', wide: true, tone: 'accent' },
  { mark: '∿', title: 'Лаборатории', text: 'Графики, Монте-Карло и 3D-сцены. Ручки рядом с рисунком; на телефоне график остаётся на экране, пока двигаете ползунок.', tone: 'signal' },
  { mark: '?', title: 'Что спросят', text: 'Урок начинается с вопросов контрольной по теме — читаете прицельно.' },
  { mark: '§', title: 'Теория по учебнику', text: 'Со ссылками на главы и параграфы, выводы по шагам. Числа проверены тестами.' },
  { mark: '✓', title: 'Проверка и тренажёры', text: 'Вопросы с объяснением и тренажёры, которые проверяют ответ численно, а не сверяют буквы.' },
  { mark: 'Σ', title: 'Контрольные и шпаргалка', text: 'Варианты с генерацией чисел и проверкой ответа с допуском, все формулы курса на одной странице для печати.', wide: true },
];
---
<Base title={SITE.title} description={SITE.description} type="website">
  <div class="sg-page">
    <SiteHeader current="courses" />
    <DotField client:idle />

    <section class="sg-hero">
      <div class="sg-hero-text">
        <div class="sg-pill">Бесплатно · без регистрации · открытый код</div>
        <h1>Физика и математика, которые можно <span class="sg-grad">покрутить руками</span></h1>
        <p>Интерактивные курсы для подготовки к контрольным и экзаменам в магистратуре МИФИ: теория по учебнику, выводы по шагам, лаборатории с ползунками и 3D, формулы, которые объясняют себя.</p>
        <div class="sg-hero-actions">
          <a class="rz-btn rz-btn-primary rz-btn-md" href="#courses">Выбрать курс</a>
          <a class="rz-btn rz-btn-quiet rz-btn-md" href="#try">Попробовать лабораторию</a>
        </div>
        {fallback && <ContinueCard client:idle lessonsByCourse={lessonsByCourse} fallback={fallback} />}
      </div>
      {hero?.display && (
        <div class="sg-hero-art">
          <BigFormula client:visible display={hero.display} tex="E^2 = (pc)^2 + (mc^2)^2" title={hero.title} symbols={hero.symbols.map(({ s, tex, text }) => ({ s, tex, text }))} />
        </div>
      )}
    </section>

    <dl class="sg-numbers" aria-label="Sigma в цифрах">
      {numbers.map((n) => (
        <div class="sg-number">
          <dt>{n.label}<span>{n.note}</span></dt>
          <dd>{n.value}</dd>
        </div>
      ))}
    </dl>

    <section class="sg-land" aria-labelledby="how">
      <div class="sg-land-head">
        <h2 id="how">Как устроен урок</h2>
        <p>Один урок — одна тема пособия, 25–45 минут. Всё, что нужно к контрольной, на одной странице: с телефона в метро или с ноутбука перед экзаменом.</p>
      </div>
      <ul class="sg-bento">
        {features.map((f) => (
          <li class:list={[f.wide && 'is-wide', f.tone && `is-${f.tone}`]}>
            <span class="sg-feature-mark" aria-hidden="true">{f.mark}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="sg-land" aria-labelledby="try">
      <div class="sg-land-head">
        <h2 id="try">Попробуйте прямо здесь</h2>
        <p>
          Лаборатория из урока
          {demoLesson ? <a href={demoLesson.href}> {demoLesson.n} «{demoLesson.title}»</a> : ' курса'}: нейтроны летят в пластину, каждый трек разыгран по сечениям.
          Поменяйте толщину и состав — доля прошедших сравнивается с законом ослабления.
        </p>
      </div>
      <SlabMC3D client:visible />
    </section>

    <section class="sg-land sg-land-catalog" aria-label="Каталог">
      <CourseCatalog client:idle courses={courses} />
      <p class="sg-land-note">Курсы появляются по мере подготовки к сессии: каждый собран по конкретному учебнику и конспектам лекций.</p>
    </section>

    <section class="sg-land sg-split-land" aria-labelledby="progress">
      <div class="sg-land-head">
        <h2 id="progress">Прогресс без аккаунта</h2>
      </div>
      <div class="sg-land-body">
        <p>Регистрации нет. Пройденные уроки и последний открытый урок запоминаются в этом браузере — главная сразу предлагает продолжить с того места, где вы остановились.</p>
        <p>Чтобы перенести прогресс на телефон или другой компьютер, на странице курса есть кнопка «Ссылка на мой прогресс»: откройте ссылку на другом устройстве, и отметки объединятся.</p>
      </div>
    </section>

    <section id="about" class="sg-land sg-split-land" aria-labelledby="about-h">
      <div class="sg-land-head">
        <h2 id="about-h">О проекте</h2>
      </div>
      <div class="sg-land-body">
        <p>Sigma начиналась как личный конспект к контрольным в магистратуре МИФИ. Учебник читается тяжело, а формула становится понятной, когда видно, что она делает: поэтому к каждой теме — лаборатория, где параметры можно менять и сразу смотреть на результат.</p>
        <p>Проект открытый: тексты уроков, лаборатории и код сайта лежат на GitHub под лицензией {SITE.license.name}. Их можно использовать, менять и распространять со ссылкой на репозиторий. Урок — это MDX-файл с формулами, лаборатория — React-компонент; нашли ошибку в физике или опечатку — откройте issue или pull request.</p>
        <ul class="sg-stack" aria-label="На чём сделано">
          <li>Astro</li><li>React</li><li>KaTeX</li><li>three.js</li><li>Canvas 2D</li><li>Vitest и Playwright</li>
        </ul>
        <div class="sg-hero-actions">
          <a class="rz-btn rz-btn-primary rz-btn-md" href={SITE.repo}>Репозиторий на GitHub</a>
          <a class="rz-btn rz-btn-ghost rz-btn-md" href={SITE.license.href} rel="license">Лицензия {SITE.license.name}</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .sg-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: var(--space-8) var(--space-12); padding: 72px 0 48px; }
  .sg-hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-width: 0; }
  .sg-pill { display: inline-flex; align-items: center; min-height: 32px; padding: 0 14px; border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--surface-1); font: 650 13px/18px var(--font-sans); color: var(--ink-muted); }
  .sg-hero h1 { margin: 0; font: 800 clamp(36px, 5.6vw, 68px)/1.02 var(--font-sans); letter-spacing: -0.04em; text-wrap: balance; }
  .sg-grad { color: var(--accent-text); text-decoration: underline wavy var(--signal); text-decoration-thickness: 3px; text-underline-offset: 10px; text-decoration-skip-ink: none; }
  .sg-hero p { margin: 0; max-width: 34em; font: 400 19px/31px var(--font-serif); color: var(--ink-muted); }
  .sg-hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .sg-hero-art { min-width: 0; }
  .sg-continue { display: flex; flex-direction: column; gap: 8px; width: min(100%, 420px); margin-top: var(--space-4); padding: 18px 22px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-xl); color: var(--ink); box-shadow: var(--shadow-lift); transition: transform .2s, border-color .2s; }
  .sg-continue:hover { color: var(--ink); border-color: var(--accent); transform: translateY(-2px); }
  .sg-continue:hover .sg-continue-title { color: var(--accent-text); }
  .sg-continue-title { font: 750 17px/24px var(--font-sans); }
  .sg-continue-meta { font: 500 14px/20px var(--font-sans); color: var(--ink-muted); }

  .sg-numbers { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin: 0; }
  .sg-number { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; padding: 22px 24px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-xl); }
  .sg-number dd { margin: 0; font: 800 48px/52px var(--font-sans); letter-spacing: -0.04em; color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .sg-number dt { display: flex; flex-direction: column; gap: 2px; font: 750 16px/22px var(--font-sans); }
  .sg-number dt span { font-weight: 500; font-size: 13px; line-height: 18px; color: var(--ink-muted); }

  .sg-land { margin-top: 96px; }
  .sg-land-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-12); margin-bottom: var(--space-6); }
  .sg-land-head h2 { flex: 0 0 auto; margin: 0; font: 800 clamp(28px, 3.4vw, 40px)/1.1 var(--font-sans); letter-spacing: -0.03em; }
  .sg-land-head p { flex: 1 1 420px; max-width: var(--measure); margin: 0; font: 400 17px/28px var(--font-serif); color: var(--ink-muted); }

  .sg-bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  .sg-bento li { display: flex; flex-direction: column; gap: var(--space-2); padding: 24px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-xl); transition: transform .2s, box-shadow .2s; }
  .sg-bento li:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .sg-bento li.is-wide { grid-column: span 2; }
  .sg-bento li.is-accent { background: #1481ba; border-color: transparent; color: #ffffff; }
  .sg-bento li.is-accent p { color: rgba(255, 255, 255, .86); }
  .sg-bento li.is-accent .sg-feature-mark { background: rgba(255, 255, 255, .18); color: #ffffff; }
  .sg-bento li.is-signal { background: var(--signal-soft); border-color: color-mix(in srgb, var(--signal) 30%, transparent); }
  .sg-bento li.is-signal .sg-feature-mark { background: var(--signal); color: #ffffff; }
  .sg-feature-mark { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--accent-soft); color: var(--accent-text); font: 700 22px/1 var(--font-serif); }
  .sg-bento h3 { margin: 10px 0 0; font: 800 20px/26px var(--font-sans); letter-spacing: -0.02em; }
  .sg-bento p { margin: 0; font: 500 15px/24px var(--font-sans); color: var(--ink-muted); }

  .sg-land-catalog { scroll-margin-top: var(--header-h); }
  .sg-land-note { margin: var(--space-4) 0 0; font: 500 15px/24px var(--font-sans); color: var(--ink-muted); }

  .sg-split-land { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: var(--space-4) var(--space-12); padding: var(--space-8); background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-xl); }
  .sg-split-land .sg-land-head { margin: 0; min-width: 0; }
  .sg-split-land .sg-land-head h2 { flex: 1 1 auto; min-width: 0; font-size: clamp(26px, 2.6vw, 34px); overflow-wrap: anywhere; }
  .sg-land-body { max-width: var(--measure); }
  .sg-land-body p { margin: 0 0 14px; font: 400 17px/28px var(--font-serif); color: var(--ink-muted); }
  .sg-stack { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; padding: 0; list-style: none; }
  .sg-stack li { padding: 4px 12px; border: 1px solid var(--rule); border-radius: var(--radius-pill); font: 650 13px/20px var(--font-sans); color: var(--ink-muted); }
  .sg-land + .sg-split-land { margin-top: var(--space-8); }
  .sg-split-land + .sg-split-land { margin-top: var(--space-3); }

  .sg-filters { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6); }
  .sg-filters-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-3) var(--space-8); }
  .sg-search-inline { position: relative; display: block; max-width: 560px; }
  .sg-search-inline svg { position: absolute; left: 16px; top: 50%; width: 18px; height: 18px; transform: translateY(-50%); fill: none; stroke: var(--ink-muted); stroke-width: 2.2; stroke-linecap: round; pointer-events: none; }
  .sg-search-inline .sg-field { padding-left: 44px; }

  .sg-section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: 0 0 16px; }
  .sg-section-head h2 { margin: 0; font: 800 clamp(28px, 3.4vw, 40px)/1.1 var(--font-sans); letter-spacing: -0.03em; }
  .sg-count { font: 600 14px/20px var(--font-sans); color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .sg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4); }
  .sg-empty { display: flex; align-items: center; gap: var(--space-2); margin: var(--space-6) 0 0; font: 500 16px/26px var(--font-sans); color: var(--ink-muted); }

  @media (max-width: 1000px) {
    .sg-hero { grid-template-columns: 1fr; padding: 40px 0 32px; }
    .sg-bento { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 899px) {
    .sg-hero p { font-size: 17px; line-height: 28px; }
    .sg-numbers { grid-template-columns: 1fr 1fr; }
    .sg-number { padding: 16px 18px; }
    .sg-number dd { font-size: 36px; line-height: 40px; }
    .sg-land { margin-top: 64px; }
    .sg-split-land { grid-template-columns: 1fr; padding: var(--space-6); }
  }
  @media (max-width: 599px) {
    .sg-bento { grid-template-columns: 1fr; }
    .sg-bento li.is-wide { grid-column: auto; }
    .sg-grid { grid-template-columns: 1fr; }
  }
</style>
