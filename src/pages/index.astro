---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CourseCatalog from '../components/live/CourseCatalog';
import ContinueCard from '../components/live/ContinueCard';
import SlabMC3D from '../labs/tpn/SlabMC3D';
import { getCourse, listCourses, siteStats } from '../lib/courses';
import { plural } from '../lib/plural';
import { SITE } from '../lib/site';

const courses = await listCourses();
const lessonsByCourse = Object.fromEntries(courses.filter((c) => !c.example).map((c) => [c.id, c.lessons]));
const stats = await siteStats();

// Пока ничего не открыто, «Начать» ведёт к первому уроку курса, где написано больше всего уроков.
const real = await Promise.all(courses.filter((c) => !c.example).map((c) => getCourse(c.id)));
const fullest = real.sort((a, b) => b.lessons.filter((l) => l.href).length - a.lessons.filter((l) => l.href).length)[0];
const firstLesson = fullest?.lessons.find((l) => l.href);
const fallback = fullest && firstLesson
  ? { course: fullest.id, n: firstLesson.n, title: firstLesson.title, courseTitle: fullest.course.data.title, href: firstLesson.href! }
  : undefined;
// Урок, из которого взята лаборатория на главной.
const demoLesson = real.flatMap((d) => d.lessons).find((l) => l.entry?.body?.includes('@labs/tpn/SlabMC3D'));

const numbers = [
  { value: stats.lessons, label: plural(stats.lessons, 'урок', 'урока', 'уроков'), note: 'по учебнику и лекциям' },
  { value: stats.labs, label: plural(stats.labs, 'лаборатория', 'лаборатории', 'лабораторий'), note: `из них ${stats.labs3d} в 3D` },
  { value: stats.questions + stats.tasks, label: 'заданий для самопроверки', note: `${stats.questions} вопросов и ${stats.tasks} задач в контрольной и самостоятельных` },
  { value: stats.formulas, label: plural(stats.formulas, 'формула', 'формулы', 'формул'), note: 'в шпаргалке на А4' },
];

const features = [
  { mark: '?', title: 'Что спросят', text: 'Урок начинается с вопросов контрольной по этой теме — читаете прицельно и знаете, что важно.' },
  { mark: '§', title: 'Теория по учебнику', text: 'Со ссылками на главы и параграфы, формулами и выводами по шагам. Числа и формулы проверены тестами.' },
  { mark: '∿', title: 'Лаборатории 2D', text: 'Графики, гистограммы и Монте-Карло. Двигаете ползунок — рисунок и числа под ним меняются сразу.' },
  { mark: '◇', title: '3D-сцены', text: 'Пучок нейтронов в пластине, волна на ядре, деление капли, газ в ящике — вращаются пальцем и мышью.' },
  { mark: '✓', title: 'Проверка и тренажёры', text: 'Вопросы в конце урока с объяснением. В математике — тренажёр: ответ вводится формулой и проверяется численно, так что 2x и x·2 засчитываются одинаково.' },
  { mark: 'Σ', title: 'Контрольная, самостоятельные и шпаргалка', text: 'Пробная контрольная с пошаговыми решениями, самостоятельные, где числовой ответ проверяется с допуском на округление, и все формулы курса на одной странице для печати.' },
];
---
<Base title={SITE.title} description={SITE.description} type="website">
  <div class="sg-page">
    <SiteHeader current="courses" />

    <section class="sg-hero">
      <div class="sg-hero-text">
        <div class="sg-eyebrow">Бесплатно · без регистрации · открытый код</div>
        <h1>Физика и математика, которые можно покрутить руками</h1>
        <p>Sigma — интерактивные курсы для подготовки к контрольным и экзаменам в магистратуре МИФИ. Теория по учебнику со ссылками на главы, выводы по шагам, лаборатории с ползунками и 3D-сценами и тренажёры, которые проверяют ваш ответ, а не сверяют буквы.</p>
        <div class="sg-hero-actions">
          <a class="rz-btn rz-btn-primary rz-btn-md" href="#courses">Выбрать курс</a>
          <a class="rz-btn rz-btn-ghost rz-btn-md" href={SITE.repo}>Исходный код на GitHub</a>
        </div>
      </div>
      {fallback && <ContinueCard client:idle lessonsByCourse={lessonsByCourse} fallback={fallback} />}
    </section>

    <dl class="sg-numbers" aria-label="Sigma в цифрах">
      {numbers.map((n) => (
        <div class="sg-number">
          <dt>{n.label}<span>{n.note}</span></dt>
          <dd>{n.value}</dd>
        </div>
      ))}
    </dl>

    <section class="sg-land" aria-labelledby="how">
      <div class="sg-land-head">
        <h2 id="how">Как устроен урок</h2>
        <p>Один урок — одна тема пособия, 25–45 минут. Всё, что нужно к контрольной, на одной странице: с телефона в метро или с ноутбука перед экзаменом.</p>
      </div>
      <ul class="sg-features">
        {features.map((f) => (
          <li>
            <span class="sg-feature-mark" aria-hidden="true">{f.mark}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="sg-land" aria-labelledby="try">
      <div class="sg-land-head">
        <h2 id="try">Попробуйте прямо здесь</h2>
        <p>
          Лаборатория из урока
          {demoLesson ? <a href={demoLesson.href}> {demoLesson.n} «{demoLesson.title}»</a> : ' курса'}: нейтроны летят в пластину, каждый трек разыгран по сечениям.
          Поменяйте толщину и состав — доля прошедших сравнивается с законом ослабления.
        </p>
      </div>
      <SlabMC3D client:visible />
    </section>

    <section class="sg-land sg-land-catalog" aria-label="Каталог">
      <CourseCatalog client:idle courses={courses} />
      <p class="sg-land-note">Курсы появляются по мере подготовки к сессии: каждый собран по конкретному учебнику и конспектам лекций.</p>
    </section>

    <section class="sg-land sg-split-land" aria-labelledby="progress">
      <div class="sg-land-head">
        <h2 id="progress">Прогресс без аккаунта</h2>
      </div>
      <div class="sg-land-body">
        <p>Регистрации нет. Пройденные уроки и последний открытый урок запоминаются в этом браузере — главная сразу предлагает продолжить с того места, где вы остановились.</p>
        <p>Чтобы перенести прогресс на телефон или другой компьютер, на странице курса есть кнопка «Ссылка на мой прогресс»: откройте ссылку на другом устройстве, и отметки объединятся.</p>
      </div>
    </section>

    <section id="about" class="sg-land sg-split-land" aria-labelledby="about-h">
      <div class="sg-land-head">
        <h2 id="about-h">О проекте</h2>
      </div>
      <div class="sg-land-body">
        <p>Sigma начиналась как личный конспект к контрольным в магистратуре МИФИ. Учебник читается тяжело, а формула становится понятной, когда видно, что она делает: поэтому к каждой теме — лаборатория, где параметры можно менять и сразу смотреть на результат.</p>
        <p>Проект открытый: тексты уроков, лаборатории и код сайта лежат на GitHub под лицензией {SITE.license.name}. Их можно использовать, менять и распространять со ссылкой на репозиторий. Урок — это MDX-файл с формулами, лаборатория — React-компонент; нашли ошибку в физике или опечатку — откройте issue или pull request.</p>
        <ul class="sg-stack" aria-label="На чём сделано">
          <li>Astro</li><li>React</li><li>KaTeX</li><li>three.js</li><li>Canvas 2D</li><li>Vitest и Playwright</li>
        </ul>
        <div class="sg-hero-actions">
          <a class="rz-btn rz-btn-primary rz-btn-md" href={SITE.repo}>Репозиторий на GitHub</a>
          <a class="rz-btn rz-btn-ghost rz-btn-md" href={SITE.license.href} rel="license">Лицензия {SITE.license.name}</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .sg-hero { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-8) var(--space-12); padding: 64px 0 40px; }
  .sg-hero-text { flex: 1 1 560px; display: flex; flex-direction: column; gap: var(--space-4); }
  .sg-hero h1 { margin: 0; max-width: 13em; font: 600 52px/56px var(--font-sans); letter-spacing: -0.03em; text-wrap: balance; }
  .sg-hero p { margin: 0; max-width: 34em; font: 400 19px/31px var(--font-serif); color: var(--ink-muted); }
  .sg-hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .sg-continue { flex: 0 1 360px; display: flex; flex-direction: column; gap: 10px; padding: 20px 24px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-lg); color: var(--ink); }
  .sg-continue:hover { color: var(--ink); border-color: var(--rule-strong); }
  .sg-continue:hover .sg-continue-title { color: var(--accent); }
  .sg-continue-title { font: 600 17px/24px var(--font-sans); }
  .sg-continue-meta { font: 400 14px/20px var(--font-sans); color: var(--ink-muted); }

  .sg-numbers { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .sg-number { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 4px; padding: 24px 24px 24px 0; }
  .sg-number + .sg-number { padding-left: 24px; border-left: 1px solid var(--rule); }
  .sg-number dd { margin: 0; font: 600 44px/48px var(--font-sans); letter-spacing: -0.02em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .sg-number dt { display: flex; flex-direction: column; gap: 2px; font: 600 16px/22px var(--font-sans); }
  .sg-number dt span { font-weight: 400; font-size: 14px; line-height: 20px; color: var(--ink-muted); }

  .sg-land { margin-top: var(--space-16); }
  .sg-land-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-12); margin-bottom: var(--space-6); }
  .sg-land-head h2 { flex: 0 0 auto; margin: 0; font: 600 28px/34px var(--font-sans); letter-spacing: -0.015em; }
  .sg-land-head p { flex: 1 1 420px; max-width: var(--measure); margin: 0; font: 400 17px/28px var(--font-serif); color: var(--ink-muted); }

  .sg-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .sg-features li { display: flex; flex-direction: column; gap: var(--space-2); padding: 20px 22px 22px; background: var(--surface-1); border: 1px solid var(--rule); border-radius: var(--radius-lg); }
  .sg-feature-mark { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-md); background: var(--accent-soft); color: var(--accent); font: 600 18px/1 var(--font-sans); }
  .sg-features h3 { margin: 6px 0 0; font: 600 17px/24px var(--font-sans); }
  .sg-features p { margin: 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }

  .sg-land-catalog { padding-top: var(--space-8); border-top: 1px solid var(--rule); }
  .sg-land-note { margin: var(--space-4) 0 0; font: 400 15px/24px var(--font-sans); color: var(--ink-muted); }

  .sg-split-land { display: grid; grid-template-columns: 300px 1fr; gap: var(--space-4) var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--rule); }
  .sg-split-land .sg-land-head { margin: 0; }
  .sg-land-body { max-width: var(--measure); }
  .sg-land-body p { margin: 0 0 14px; font: 400 17px/28px var(--font-serif); color: var(--ink-muted); }
  .sg-stack { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; padding: 0; list-style: none; }
  .sg-stack li { padding: 4px 12px; border: 1px solid var(--rule); border-radius: var(--radius-pill); font: 500 13px/20px var(--font-sans); color: var(--ink-muted); }

  .sg-filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-4) var(--space-6); padding: 20px 0; border-top: 1px solid var(--rule); }
  .sg-field-wrap { display: flex; flex-direction: column; gap: 6px; font: 500 14px/20px var(--font-sans); }
  .sg-field-grow { flex: 1 1 280px; }
  .sg-field { height: 44px; padding: 0 14px; border: 1px solid var(--rule-strong); border-radius: var(--radius-md); background: var(--surface-1); color: var(--ink); font: 400 15px/22px var(--font-sans); }
  .sg-field:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .sg-section-head { display: flex; justify-content: space-between; align-items: baseline; padding: 0 0 16px; }
  .sg-section-head h2 { margin: 0; font: 600 28px/34px var(--font-sans); letter-spacing: -0.015em; }
  .sg-count { font: 400 14px/20px var(--font-sans); color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .sg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4); }
  .sg-empty { margin: var(--space-6) 0 0; font: 400 16px/26px var(--font-serif); color: var(--ink-muted); }

  @media (max-width: 899px) {
    .sg-hero { padding: 32px 0 28px; }
    .sg-hero h1 { font-size: 34px; line-height: 40px; }
    .sg-hero p { font-size: 17px; line-height: 28px; }
    .sg-continue { flex-basis: 100%; }
    .sg-numbers { grid-template-columns: 1fr 1fr; }
    .sg-number { padding: 18px 16px 18px 0; }
    .sg-number + .sg-number { padding-left: 0; border-left: 0; }
    .sg-number:nth-child(2n) { padding-left: 16px; border-left: 1px solid var(--rule); }
    .sg-number:nth-child(n + 3) { border-top: 1px solid var(--rule); }
    .sg-number dd { font-size: 34px; line-height: 40px; }
    .sg-land { margin-top: var(--space-12); }
    .sg-land-head h2, .sg-section-head h2 { font-size: 24px; line-height: 30px; }
    .sg-features { grid-template-columns: 1fr; }
    .sg-split-land { grid-template-columns: 1fr; }
    .sg-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 900px) and (max-width: 1100px) { .sg-features { grid-template-columns: 1fr 1fr; } }
</style>
